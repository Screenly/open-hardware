  (fp_text value SOT-23-6 (at 0 2.5) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_line (start -0.4 -1.45) (end 0.8 -1.45) (layer F.Fab) (width 0.1))
  (fp_line (start 0.8 -1.45) (end 0.8 1.45) (layer F.Fab) (width 0.1))
  (fp_line (start 0.8 1.45) (end -0.8 1.45) (layer F.Fab) (width 0.1))
  (fp_line (start -0.8 1.45) (end -0.8 -1.05) (layer F.Fab) (width 0.1))
  (fp_line (start -0.8 -1.05) (end -0.4 -1.45) (layer F.Fab) (width 0.1))
  (fp_line (start -1.7 -1.56) (end 0.8 -1.56) (layer F.SilkS) (width 0.12))
  (fp_line (start -0.8 1.56) (end 0.8 1.56) (layer F.SilkS) (width 0.12))
  (fp_line (start -1.95 -1.7) (end 1.95 -1.7) (layer F.CrtYd) (width 0.05))
  (fp_line (start 1.95 -1.7) (end 1.95 1.7) (layer F.CrtYd) (width 0.05))
  (fp_line (start 1.95 1.7) (end -1.95 1.7) (layer F.CrtYd) (width 0.05))
  (fp_line (start -1.95 1.7) (end -1.95 -1.7) (layer F.CrtYd) (width 0.05))
  (pad 1 smd rect (at -1.25 -0.95) (size 0.9 0.7) (layers F.Cu F.Paste F.Mask))
  (pad 2 smd rect (at -1.25 0) (size 0.9 0.7) (layers F.Cu F.Paste F.Mask))
  (pad 3 smd rect (at -1.25 0.95) (size 0.9 0.7) (layers F.Cu F.Paste F.Mask))
  (pad 4 smd rect (at 1.25 0.95) (size 0.9 0.7) (layers F.Cu F.Paste F.Mask))
  (pad 5 smd rect (at 1.25 0) (size 0.9 0.7) (layers F.Cu F.Paste F.Mask))
  (pad 6 smd rect (at 1.25 -0.95) (size 0.9 0.7) (layers F.Cu F.Paste F.Mask))
  (model ${SCREENLY_LIB}/3d-models/SOT-23-6.step
    (at (xyz 0 0 0))
    (scale (xyz 1 1 1))
    (rotate (xyz 0 0 0))
  )
)
