(module SOT-23 (layer F.Cu) (tedit 6A1C0000)
  (descr "SOT-23 (TO-236), pads per JSCJ suggested pad layout (0.6 x 0.8 mm pads, 1.9 mm pitch, 2.02 mm row spacing), pin 1 top-left as KiCad standard")
  (tags "SOT-23 SOT23 TO-236")
  (attr smd)
  (fp_text reference Q? (at 0 -2.4) (layer F.SilkS)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text user %R (at 0 0 90) (layer F.Fab)
    (effects (font (size 0.5 0.5) (thickness 0.075)))
  )
  (fp_text value SOT-23 (at 0 2.4) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_line (start -0.35 -1.46) (end 0.65 -1.46) (layer F.Fab) (width 0.1))
  (fp_line (start 0.65 -1.46) (end 0.65 1.46) (layer F.Fab) (width 0.1))
  (fp_line (start 0.65 1.46) (end -0.65 1.46) (layer F.Fab) (width 0.1))
  (fp_line (start -0.65 1.46) (end -0.65 -1.16) (layer F.Fab) (width 0.1))
  (fp_line (start -0.65 -1.16) (end -0.35 -1.46) (layer F.Fab) (width 0.1))
  (fp_line (start -1.41 -1.56) (end 0.65 -1.56) (layer F.SilkS) (width 0.12))
  (fp_line (start 0.65 -1.56) (end 0.65 -0.5) (layer F.SilkS) (width 0.12))
  (fp_line (start -0.65 1.56) (end 0.65 1.56) (layer F.SilkS) (width 0.12))
  (fp_line (start 0.65 1.56) (end 0.65 0.5) (layer F.SilkS) (width 0.12))
  (fp_line (start -1.66 -1.7) (end 1.66 -1.7) (layer F.CrtYd) (width 0.05))
  (fp_line (start 1.66 -1.7) (end 1.66 1.7) (layer F.CrtYd) (width 0.05))
  (fp_line (start 1.66 1.7) (end -1.66 1.7) (layer F.CrtYd) (width 0.05))
  (fp_line (start -1.66 1.7) (end -1.66 -1.7) (layer F.CrtYd) (width 0.05))
  (pad 1 smd rect (at -1.01 -0.95) (size 0.8 0.6) (layers F.Cu F.Paste F.Mask))
  (pad 2 smd rect (at -1.01 0.95) (size 0.8 0.6) (layers F.Cu F.Paste F.Mask))
  (pad 3 smd rect (at 1.01 0) (size 0.8 0.6) (layers F.Cu F.Paste F.Mask))
  (model ${SCREENLY_LIB}/3d-models/SOT-23.step
    (at (xyz 0 0 0))
    (scale (xyz 1 1 1))
    (rotate (xyz 0 0 0))
  )
)
