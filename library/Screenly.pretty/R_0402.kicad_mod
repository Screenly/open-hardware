(module R_0402 (layer F.Cu) (tedit 5DEE0559)
  (descr "Resistor SMD 0402, reflow soldering")
  (tags "resistor 0402")
  (attr smd)
  (fp_text reference R? (at 0 -1.27 unlocked) (layer F.SilkS)
    (effects (font (size 1 1) (thickness 0.12)))
  )
  (fp_text value R_0402 (at 0 1.27) (layer F.Fab) hide
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_line (start -0.5 0.25) (end -0.5 -0.25) (layer F.Fab) (width 0.1))
  (fp_line (start 0.5 0.25) (end -0.5 0.25) (layer F.Fab) (width 0.1))
  (fp_line (start 0.5 -0.25) (end 0.5 0.25) (layer F.Fab) (width 0.1))
  (fp_line (start -0.5 -0.25) (end 0.5 -0.25) (layer F.Fab) (width 0.1))
  (fp_line (start 0.25 -0.4) (end -0.25 -0.4) (layer F.SilkS) (width 0.12))
  (fp_line (start -0.25 0.4) (end 0.25 0.4) (layer F.SilkS) (width 0.12))
  (fp_line (start -1 -0.4) (end 1 -0.4) (layer F.CrtYd) (width 0.05))
  (fp_line (start -1 -0.4) (end -1 0.4) (layer F.CrtYd) (width 0.05))
  (fp_line (start 1 0.4) (end 1 -0.4) (layer F.CrtYd) (width 0.05))
  (fp_line (start 1 0.4) (end -1 0.4) (layer F.CrtYd) (width 0.05))
  (pad 1 smd rect (at -0.5 0) (size 0.6 0.5) (layers F.Cu F.Paste F.Mask))
  (pad 2 smd rect (at 0.5 0) (size 0.6 0.5) (layers F.Cu F.Paste F.Mask))
  (model ${SCREENLY_LIB}/3d-models/0402_RES.stp
    (offset (xyz -0.5 -0.25 0))
    (scale (xyz 1 1 1))
    (rotate (xyz -90 0 0))
  )
)
